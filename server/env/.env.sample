##.env.dev
PORT=
DB_URL=
ACCESS_TOKEN_SECRET=
REDIS_TTL_SECS=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# --- Connected Products (linked-products launcher / cross-product SSO) ---
# REQUIRED for the "Connected products" header button to appear. Without
# REGISTRATION_API_URL the /v1/linked-products proxy returns an empty list and the
# launcher hides itself entirely (this is why the button was missing on TaskHub).
# Base URL of the WeekMate Registration service (the central product registry).
REGISTRATION_API_URL=http://localhost:5555
# Must equal Registration's API_KEY (sent as the x-api-key header to /api/linked-products).
REGISTRATION_API_KEY=
# This product's name, used by Registration to exclude TaskHub from its own list.
# Must match the product_name TaskHub is registered under (case-insensitive).
CURRENT_PRODUCT_NAME=TaskHub